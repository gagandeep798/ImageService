# Application environment — NOT committed (gitignored).
# Copy .env.template to .env and fill in values.
#
# ── Target selection ──────────────────────────────────────────────────────────
# Set AWS_ENDPOINT_URL to point everything at LocalStack.
# Comment out (or leave empty) to use real AWS.
#
#   LocalStack:  AWS_ENDPOINT_URL=http://localhost:4566
#   Real AWS:    # AWS_ENDPOINT_URL=  (unset)
#
# Per-service overrides take precedence over AWS_ENDPOINT_URL:
#   DYNAMODB_ENDPOINT_URL, S3_ENDPOINT_URL, SECRETSMANAGER_ENDPOINT_URL

AWS_ENDPOINT_URL=http://localhost:4566
ENV=local
APP_ENV=local

# ── AWS credentials ───────────────────────────────────────────────────────────
# LocalStack accepts any non-empty value. Replace with real credentials for AWS.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ── DynamoDB table names ──────────────────────────────────────────────────────
IMAGES_TABLE_NAME=image-service-images
USERS_TABLE_NAME=image-service-users
MIGRATIONS_TABLE_NAME=image-service-migrations
# ── S3 bucket names ───────────────────────────────────────────────────────────
# LocalStack account 000000000000 — replace with real account ID for AWS.
ORIGINALS_BUCKET=image-service-originals-000000000000-us-east-1
THUMBNAILS_BUCKET=image-service-thumbnails-000000000000-us-east-1
QUARANTINE_BUCKET=image-service-quarantine-000000000000-us-east-1
LOGS_BUCKET=image-service-logs-000000000000-us-east-1

# ── S3 bucket name prefixes (used by LocalStack init scripts) ─────────────────
ORIGINALS_BUCKET_PREFIX=image-service-originals
THUMBNAILS_BUCKET_PREFIX=image-service-thumbnails
QUARANTINE_BUCKET_PREFIX=image-service-quarantine
LOGS_BUCKET_PREFIX=image-service-logs
CLOUDTRAIL_BUCKET_PREFIX=image-service-cloudtrail-logs
BACKUPS_BUCKET_PREFIX=image-service-backups

# ── SQS queue names ───────────────────────────────────────────────────────────
FINALIZE_QUEUE_NAME=image-service-finalize
FINALIZE_DLQ_NAME=image-service-finalize-dlq
SCAN_QUEUE_NAME=image-service-scan
THUMBNAIL_QUEUE_NAME=image-service-thumbnails

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_BYTES=20971520
CHUNK_SIZE_BYTES=5242880
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=3600

# ── DynamoDB sharding ─────────────────────────────────────────────────────────
DYNAMO_GSI2_SHARD_COUNT=8

# ── Service metadata ─────────────────────────────────────────────────────────
SERVICE_VERSION=0.1.0

# ── Cognito ───────────────────────────────────────────────────────────────────
# Run `make cognito-init` once after `make cognito-up` and copy the output here.
# Do NOT add COGNITO_ENDPOINT_URL — SAM local injects .env into Lambda containers
# and localhost:9229 would break Docker-internal calls. The Makefile handles it.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ── Secrets ───────────────────────────────────────────────────────────────────
PII_PEPPER=localdev-placeholder-pepper-change-in-prod-aabbccddeeff00112233445566778899
SLACK_WEBHOOK_URL=http://localhost/dev-null
CLOUDFRONT_KEY_PAIR_ID=LOCAL_DEV
CLOUDFRONT_PRIVATE_KEY_B64=

# ── DynamoDB IAM role ARNs (leave empty for LocalStack) ──────────────────────
DYNAMO_READ_ROLE_ARN=
DYNAMO_WRITE_ROLE_ARN=
DYNAMO_DELETE_ROLE_ARN=
