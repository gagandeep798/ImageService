# Copy this to .env.local and fill in values.
# .env.local is NOT committed — it contains dev credentials.
#
# ── Target selection ──────────────────────────────────────────────────────────
# Set AWS_ENDPOINT_URL to point everything at LocalStack.
# Comment it out (or leave it empty) to use real AWS.
#
#   LocalStack:  AWS_ENDPOINT_URL=http://localhost:4566
#   Real AWS:    # AWS_ENDPOINT_URL=  (unset)
#
# Per-service overrides are also supported and take precedence:
#   DYNAMODB_ENDPOINT_URL, S3_ENDPOINT_URL, SECRETSMANAGER_ENDPOINT_URL

AWS_ENDPOINT_URL=http://localhost:4566
APP_ENV=local

# ── Credentials ───────────────────────────────────────────────────────────────
# LocalStack accepts any non-empty value. Replace with real credentials for AWS.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ── Bucket names ──────────────────────────────────────────────────────────────
# LocalStack account 000000000000 — replace with real account ID for AWS.
ORIGINALS_BUCKET=image-service-originals-000000000000-us-east-1
THUMBNAILS_BUCKET=image-service-thumbnails-000000000000-us-east-1
QUARANTINE_BUCKET=image-service-quarantine-000000000000-us-east-1
LOGS_BUCKET=image-service-logs-000000000000-us-east-1

# Secrets are loaded from .env.secrets (generated by scripts/fetch_secrets.sh)
# PII_PEPPER=<fetched from Secrets Manager>
