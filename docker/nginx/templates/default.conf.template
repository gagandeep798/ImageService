# This file is processed by envsubst at container start.
# Environment variables:   ${LOCALSTACK_PORT}  ${OPENSEARCH_PORT}  ${OPENSEARCH_DASHBOARDS_PORT}
# Nginx variables must be escaped as $$var so envsubst leaves them intact.

server {
    listen 80;
    server_name _;

    location /errors/ {
        root /usr/share/nginx/html;
        internal;
    }

    # LocalStack (API Gateway, S3, DynamoDB, Secrets Manager, etc.)
    location /api/ {
        proxy_pass http://localstack:${LOCALSTACK_PORT}/;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        client_max_body_size 25m;
    }

    # OpenSearch REST API
    location /opensearch/ {
        proxy_pass http://opensearch:${OPENSEARCH_PORT}/;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_read_timeout 60s;
    }

    # OpenSearch Dashboards
    location /dashboards/ {
        proxy_pass http://opensearch-dashboards:${OPENSEARCH_DASHBOARDS_PORT}/;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $$http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # LocalStack health check passthrough
    location /_localstack/health {
        proxy_pass http://localstack:${LOCALSTACK_PORT}/_localstack/health;
    }
}
