# Docker environment sample — copy to docker/.env and adjust values.
# docker/.env is gitignored; this file shows the required variable structure.
#
# Override individual values by creating docker/.env.local (not committed).

# ── Custom image version (built from docker/localstack/Dockerfile) ────────────
LOCALSTACK_VERSION=1.0.0

# ── Host-exposed port ─────────────────────────────────────────────────────────
LOCALSTACK_PORT=4566

# ── AWS / LocalStack runtime ──────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
LOCALSTACK_ACCOUNT_ID=000000000000
LOCALSTACK_DEBUG=0
LOCALSTACK_SERVICES=s3,dynamodb,lambda,apigateway,iam,sqs,kinesis,firehose,secretsmanager,cloudtrail,logs,xray,events,cognito-idp,glue,athena,ec2
