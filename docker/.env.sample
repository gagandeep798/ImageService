# Docker environment sample — copy to docker/.env and adjust values.
# docker/.env is gitignored; this file shows the required variable structure.
#
# Override individual values by creating docker/.env.local (not committed).

# ── Custom image versions (built from docker/<service>/Dockerfile) ───────────
LOCALSTACK_VERSION=1.0.0
OPENSEARCH_VERSION=1.0.0
OPENSEARCH_DASHBOARDS_VERSION=1.0.0
NGINX_VERSION=1.0.0

# ── Host-exposed port (only Nginx binds to the host) ─────────────────────────
NGINX_PORT=8080

# ── Internal container ports ─────────────────────────────────────────────────
# Used by expose:, healthchecks, and the nginx template (default.conf.template).
LOCALSTACK_PORT=4566
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601

# ── AWS / LocalStack runtime ──────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
LOCALSTACK_ACCOUNT_ID=000000000000
LOCALSTACK_DEBUG=0
LOCALSTACK_SERVICES=s3,dynamodb,lambda,apigateway,iam,sqs,kinesis,firehose,secretsmanager,cloudtrail,logs,xray,events,cognito-idp,glue,athena

# ── OpenSearch runtime ────────────────────────────────────────────────────────
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
